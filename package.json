    "@tailwindcss/vite": "^4.3.3",
    "@types/nodemailer": "^8.0.2",
    "astro": "^7.3.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cookie": "^1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
