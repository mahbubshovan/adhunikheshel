{
  "name": "adhunik-heshel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node dist/server/entry.mjs",
    "start": "node dist/server/entry.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.local.json",
    "db:seed": "wrangler d1 execute DB --local --config wrangler.local.json --file db/seed.sql",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node scripts/test-orders.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
